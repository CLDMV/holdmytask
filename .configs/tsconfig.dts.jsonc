{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": true, // helpful for IDEs
		"rootDir": "..",
		"outDir": ".././types",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"skipLibCheck": true,
		"stripInternal": true // hides /** @internal */ if you use it
	},
	"include": ["../**/*.js", "../**/*.mjs", "../**/*.d.ts"],
	"exclude": [
		"../api_test",
		"../tests",
		"../tools",
		"../types",
		"../.config",
		"../.configs",
		"../.data",
		"../dist",
		"../tmp",
		"../coverage",
		"../build",
		"../docs",
		"../examples", // demos, not part of the published API
		"../node_modules",
		"../**/* copy.mjs", // exactly "… copy.mjs"
		"../**/* copy*.mjs", // matches "… copy 3.mjs", "… copy whatever.mjs"
		"../tsup.config.mjs" // build config, not part of the package
	]
}
