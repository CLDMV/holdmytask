{
	"name": "@cldmv/holdmytask",
	"version": "2.1.0",
	"description": "A tiny task queue that waits until your task is ready",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/src/index.d.mts",
	"exports": {
		".": {
			"holdmytask-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./main": {
			"holdmytask-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/main.mjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/main.mjs"
		}
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"test": "node tests/run-vitest.mjs && npm run test:cjs",
		"test:cjs": "npm run build && node --conditions=holdmytask-dev --test tests/cjs/entry.test.cjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"test:types": "tsc --noEmit --project .configs/tsconfig.dts.jsonc",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet && npm run test:cjs",
		"ci:coverage": "npm run coverage",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
		"build:types": "tsc --project .configs/tsconfig.dts.jsonc",
		"build:ci": "npm run lint && npm run format:check && npm run build:types && npm run test:types && npm run build",
		"prepack": "npm run build",
		"precommit": "npm run build:types && npm run test:types && npm run lint && npm run test",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"keywords": [
		"task",
		"queue",
		"scheduler",
		"priority",
		"delay",
		"concurrency",
		"async",
		"promise",
		"callback",
		"timeout",
		"expire",
		"bypass",
		"task-queue",
		"job-queue",
		"priority-queue",
		"nodejs",
		"esm",
		"cjs",
		"typescript"
	],
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"license": "Apache-2.0",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"type": "module",
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	},
	"devDependencies": {
		"@cldmv/configs": "^1.3.0",
		"@cldmv/fix-headers": "^2.2.4",
		"@cldmv/vitest-runner": "^1.5.6",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^8.0.3",
		"@html-eslint/eslint-plugin": "^0.67.0",
		"@html-eslint/parser": "^0.67.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/holdmytask.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/holdmytask/issues"
	},
	"homepage": "https://github.com/CLDMV/holdmytask#readme",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/src/",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./src/main.mjs",
		"./dist/main.mjs"
	]
}
